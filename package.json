    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-localization": "~58.0.5",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "posthog-react-native": "4.44.0",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
